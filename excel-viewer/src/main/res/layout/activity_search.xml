<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_toolbar"
        android:background="@color/color_excel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:textColorHint="#99ffffff"
            android:gravity="start"
            android:id="@+id/et_search_text"
            android:background="@drawable/bg_edt_search_bar"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:hint="@string/all_reader2_search_files_hint"
            android:inputType="text"
            android:textCursorDrawable="@null"
            android:fontFamily="@font/poppins_semibold"
            android:textAlignment="viewStart"
            android:paddingStart="15dp"
            android:paddingEnd="38dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_clear"
            android:padding="10dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/et_search_text"
            app:layout_constraintEnd_toEndOf="@+id/et_search_text"
            app:layout_constraintTop_toTopOf="@+id/et_search_text"
            app:srcCompat="@drawable/ic_close"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_back"
            android:background="?attr/actionBarItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/str_action_cancel"
            android:fontFamily="@font/poppins_semibold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginVertical="9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xlsxreader.excelreader.customviews.smartrefresh.SmartRefreshLayout
        android:id="@+id/smartRefreshLayout"
        android:background="@color/color_excel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/adNative"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_toolbar">
        <RelativeLayout
            android:background="@drawable/bg_search_activity"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xlsxreader.excelreader.customviews.EmptyRecyclerView
                android:id="@+id/recycler"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_centerInParent="true"
                android:paddingVertical="5dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_empty_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/la_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/lottie_empty"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_search_result_found"/>
            </LinearLayout>
        </RelativeLayout>
    </com.xlsxreader.excelreader.customviews.smartrefresh.SmartRefreshLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/adNative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/smartRefreshLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
