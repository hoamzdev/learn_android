<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_round_rect_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="Loading…"
        android:fontFamily="@font/poppins_semibold"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <com.xlsxreader.excelreader.customviews.HorizontalProgressBar
        android:id="@+id/loading_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="38dp"
        android:layout_marginStart="46dp"
        android:layout_marginEnd="46dp"
        app:hpb_colorBackground="#ebebeb"
        app:hpb_colorProgress="#009630"
        app:hpb_progress="100"
        app:hpb_useRoundRect="true"/>
</LinearLayout>
