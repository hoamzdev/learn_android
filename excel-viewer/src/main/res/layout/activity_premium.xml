<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/premiumHolder"
    android:background="@drawable/ic_premium_activity_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iconBack"
        android:layout_width="?attr/actionBarSize"
        android:layout_height="?attr/actionBarSize"
        android:src="@drawable/ic_arrow_left_vector"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        app:tint="@color/black"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_premium_vector"
        android:adjustViewBounds="true"/>
    <TextView
        android:textSize="21sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/upgrade_to_pro"
        android:includeFontPadding="false"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="16dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/enjoy_a_seamless_premium_experience"
        android:includeFontPadding="false"
        android:paddingHorizontal="16dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/bg_btn"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/divider_color"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_remove_ads"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remove_all_ads"
                android:includeFontPadding="false"
                android:fontFamily="@font/poppins_semibold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/remove_all_ads_desc"
                android:includeFontPadding="false"
                android:alpha="0.6"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/monthlyHolder"
                    android:background="@drawable/bg_normal_corner_outline"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp">
                    <RadioButton
                        android:layout_gravity="center_vertical"
                        android:id="@+id/monthlyRadioButton"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/monthly"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/poppins_medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/simple_and_flexible_monthly_plan"
                            android:includeFontPadding="false"
                            android:alpha="0.6"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorAccent"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/txtMonthlyPrice"
                        android:padding="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/poppins_semibold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/sixMonthHolder"
                    android:background="@drawable/bg_normal_corner_outline"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="16dp">
                    <RadioButton
                        android:layout_gravity="center_vertical"
                        android:id="@+id/sixMonthRadioButton"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/six_month"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/poppins_medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/half_year_access_with_better_value"
                            android:includeFontPadding="false"
                            android:alpha="0.6"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorAccent"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/txtSixMonthPrice"
                        android:padding="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/poppins_semibold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/yearlyHolder"
                    android:background="@drawable/bg_normal_corner_outline"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="16dp">
                    <RadioButton
                        android:layout_gravity="center_vertical"
                        android:id="@+id/yearlyRadioButton"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/yearly"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/poppins_medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/best_yearly_plan_for_savings"
                            android:includeFontPadding="false"
                            android:alpha="0.6"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorAccent"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/txtYearlyPrice"
                        android:padding="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/poppins_semibold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lifetimeHolder"
                    android:background="@drawable/bg_normal_corner_outline"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="16dp">
                    <RadioButton
                        android:layout_gravity="center_vertical"
                        android:id="@+id/lifetimeRadioButton"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lifetime"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/poppins_medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/one_time_payment_lifetime_access"
                            android:includeFontPadding="false"
                            android:alpha="0.6"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorAccent"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/txtLifetimePrice"
                        android:padding="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/poppins_semibold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/txtContinue"
        android:background="@drawable/bg_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/continue_text"
        android:includeFontPadding="false"
        android:fontFamily="@font/poppins_semibold"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="12dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/txtTermsCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terms_and_conditions"
            android:includeFontPadding="false"
            android:alpha="0.6"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="   |   "
            android:includeFontPadding="false"
            android:alpha="0.6"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/txtPrivacyPolicy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy_policy"
            android:includeFontPadding="false"
            android:alpha="0.6"/>
    </LinearLayout>
</LinearLayout>
