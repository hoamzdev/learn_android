<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/nativeAdView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/bg_native_ads"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp">
            <ImageView
                android:id="@+id/adAppIcon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@color/colorAccent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:id="@+id/adText"
                android:background="@drawable/bg_ad_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AD"
                android:includeFontPadding="false"
                android:layout_marginStart="5dp"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toEndOf="@+id/adAppIcon"
                app:layout_constraintTop_toTopOf="@+id/adAppIcon"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:id="@+id/adHeadline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:includeFontPadding="false"
                android:layout_marginStart="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/adText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/adText"
                app:layout_constraintTop_toTopOf="@+id/adText"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/adAdvertiserHolder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/adText"
                app:layout_constraintTop_toBottomOf="@+id/adText">
                <RatingBar
                    android:id="@+id/adStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="0.5"
                    android:isIndicator="true"
                    android:progressTint="@color/sodk_palette_selective_yellow"
                    style="?android:attr/ratingBarStyleSmall"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/adAdvertiser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/black"
                android:id="@+id/adBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/adAdvertiserHolder"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/adCallToAction"
                android:background="@drawable/bg_btn_native_cta"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:includeFontPadding="false"
                android:textAllCaps="false"
                android:layout_marginVertical="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/adBody"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>
    <include
        android:id="@+id/nativeShimmer"
        layout="@layout/ad_native_small_shimmer"/>
</RelativeLayout>
