<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerShimmer"
    android:background="@drawable/bg_card_ads"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_color="#ccc">
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/lightTransparent"
                android:layout_width="50dp"
                android:layout_height="50dp"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp">
                <View
                    android:background="@color/lightTransparent"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="3dp"
                    android:layout_weight="1"/>
                <View
                    android:background="@color/lightTransparent"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:background="@color/lightTransparent"
                android:layout_width="90dp"
                android:layout_height="50dp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:background="@drawable/ads_icon_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AD"
            android:includeFontPadding="false"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"/>
    </RelativeLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
