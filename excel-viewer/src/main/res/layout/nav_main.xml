<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginStart="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/icon"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="24sp"
                    android:textColor="@color/text_main_color"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_app_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/iv_icon"
                    app:layout_constraintTop_toBottomOf="@+id/iv_icon"
                    style="@style/TextViewFont_PopSemiBold"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="@color/colorPrimaryLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/nav_browse_pdf"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:minHeight="55dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="19dp"
                    app:srcCompat="@drawable/ic_file"
                    app:tint="@color/colorPrimaryTint"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_main_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_file_manager"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16dp"
                    style="@style/TextViewFont_PopMedium"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/nav_share_app"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:minHeight="55dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="19dp"
                    app:srcCompat="@drawable/ic_share"
                    app:tint="@color/colorPrimaryTint"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_main_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_action_share"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16dp"
                    style="@style/TextViewFont_PopMedium"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/nav_rate_app"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:minHeight="55dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="19dp"
                    app:srcCompat="@drawable/ic_thumbs_up"
                    app:tint="@color/colorPrimaryTint"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_main_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_rate_us"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16dp"
                    style="@style/TextViewFont_PopMedium"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/nav_language"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:minHeight="55dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="@color/colorPrimaryTint"
                    android:layout_marginStart="19dp"
                    app:srcCompat="@drawable/ic_language"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_main_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/navigation_language"
                        android:includeFontPadding="false"
                        style="@style/TextViewFont_PopMedium"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorNormalText"
                        android:id="@+id/tv_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:includeFontPadding="false"
                        style="@style/TextViewFont_PopRegular"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/nav_feedback"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:minHeight="55dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="19dp"
                    app:srcCompat="@drawable/ic_feedback"
                    app:tint="@color/colorPrimaryTint"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_main_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_feedback_or_suggestion"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16dp"
                    style="@style/TextViewFont_PopMedium"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/nav_policy"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:minHeight="55dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="19dp"
                    app:srcCompat="@drawable/ic_privacy_policy"
                    app:tint="@color/colorPrimaryTint"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_main_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_privacy_policy"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16dp"
                    style="@style/TextViewFont_PopMedium"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/nav_premium"
        android:background="@drawable/bg_btn"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="16dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/unlock_all_features"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/unlock_all_features_desc"
                android:includeFontPadding="false"
                android:alpha="0.7"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_crown"
            android:adjustViewBounds="true"/>
    </LinearLayout>
</LinearLayout>
