<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="false"
    tools:context=".ui.main.MainActivity6">

    <LinearLayout
        android:id="@+id/ln_name_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_37B43D"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical">

        <com.example.testBaseApp.ui.common.component.MovableText
            android:id="@+id/tv_name_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next"
            android:layout_marginTop="@dimen/size30"
            android:background="@color/color_37B43D"
            android:paddingVertical="@dimen/size5"
            android:textColor="@color/white"
            android:gravity="center_vertical|center_horizontal"
            style="@style/TextView.Subtext.14"/>

    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/ln_name_file"
        app:layout_constraintBottom_toTopOf="@id/rcTabs"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>

    <ProgressBar
        android:visibility="invisible"
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/rcTabs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:indeterminateTint="@color/color_tag_diagnosis"
        app:layout_constraintTop_toTopOf="parent"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcTabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:background="@color/color_37B43D"
        tools:listitem="@layout/item_tab"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>