<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_sheet_12"
    android:elevation="@dimen/size8"
    android:fitsSystemWindows="false"
    android:layout_height="wrap_content">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/dragView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/color_909A92"
        android:layout_marginTop="@dimen/size5" />


    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/dragView"
        android:text="Customize content"
        android:gravity="center"
        android:textColor="@color/color_909A92"
        android:textStyle="bold"
        android:textSize="@dimen/size18" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/image_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size20"
        android:layout_marginHorizontal="@dimen/size20"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:cardElevation="@dimen/size2"
        app:cardCornerRadius="@dimen/size16"
        app:strokeWidth="0dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@drawable/img_home" />

    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/tvSubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/image_item"
        android:layout_marginTop="@dimen/size10"
        android:text="@string/sub_title"
        android:gravity="center"
        android:paddingHorizontal="@dimen/size10"
        android:layout_marginHorizontal="@dimen/size16"
        app:layout_constraintBottom_toTopOf="@id/btnPrimaryButton"
        android:textSize="@dimen/sizesp14"
        android:textColor="@color/color_909A92" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvSubTitle"
        android:layout_marginHorizontal="@dimen/size16"
        android:background="@drawable/bg_12"
        android:backgroundTint="#BB3161"
        android:layout_marginTop="@dimen/size30"
        android:text="Primary Button"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/sizesp16"
        android:paddingVertical="@dimen/size18"
        app:layout_constraintBottom_toTopOf="@id/edtFeedback" />


    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edtFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btnPrimaryButton"
        android:background="@drawable/bg_edt_12"
        android:layout_marginHorizontal="@dimen/size16"
        android:layout_marginTop="@dimen/size20"
        android:layout_marginBottom="@dimen/size40"
        android:paddingVertical="@dimen/size16"
        android:hint="Enter your feedback"
        android:textSize="@dimen/sizesp15"
        android:paddingHorizontal="@dimen/size13"
        android:textColorHint="@color/color_909A92"
        android:textColor="#B4000000"
        android:imeOptions="actionGo"
        android:inputType="numberPassword"
        app:layout_constraintBottom_toBottomOf="parent"
        android:maxLines="1" />


</androidx.constraintlayout.widget.ConstraintLayout>