<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_back"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_left_vector"
        app:tint="@color/white"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTittle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/poppins_semibold"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll_more"
        app:layout_constraintStart_toEndOf="@+id/img_back"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_more"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btnSaveAsPdf"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:visibility="visible"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/sodk_editor_icon_save_pdf"
            android:scaleType="centerCrop"
            android:layout_marginEnd="8dp"
            app:tint="@color/white"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/btnSave"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:visibility="visible"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/baseline_save_24"
            android:scaleType="centerCrop"
            android:contentDescription="@string/save"
            android:layout_marginEnd="8dp"
            app:tint="@color/white"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/btnPrint"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:visibility="visible"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_print"
            android:scaleType="centerCrop"
            android:contentDescription="@string/str_action_print"
            android:layout_marginEnd="8dp"
            app:tint="@color/white"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
