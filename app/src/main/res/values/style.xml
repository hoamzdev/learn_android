    <style name="BaseBottomSheetDialog" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>


    <!--Custom style ads native-->
    <style name="AppBaseTheme" parent="android:Theme.Light"/>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme"/>

    <style name="AppTheme.AdHeadline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">@color/color_text_ad_head_line</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/nexapro_trial_regular</item>
    </style>

    <style name="AppTheme.AdBody">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">@color/color_text_ad_body</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nexapro_trial_regular</item>
    </style>

    <style name="AppTheme.Advertiser">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">@color/color_text_ad_body</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nexapro_trial_regular</item>
    </style>

    <style name="AppTheme.AdPrice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">@color/color_text_ad_body</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nexapro_trial_regular</item>
    </style>

    <style name="AppTheme.AdCallToAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/nexapro_trial_regular</item>
    </style>

</resources>