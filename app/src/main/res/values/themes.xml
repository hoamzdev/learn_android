<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.testBaseApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Sử dụng màu colorSurface của hệ thống: Tự trắng khi Sáng, tự đen khi Tối -->
        <item name="android:statusBarColor">?attr/colorSurface</item>

        <!-- Bật tính năng tự động đảo màu chữ/icon theo nền -->
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        
        <item name="popupWindowStyle">@style/Widget.App.CustomPopupMenu</item>
    </style>

    <style name="Theme.testBaseApp" parent="Base.Theme.testBaseApp" />

    <style name="Widget.App.CustomPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
        <item name="android:minWidth">220dp</item>
    </style>
</resources>