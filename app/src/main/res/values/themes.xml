<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.SampleCleanArchitecture" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Sử dụng màu colorSurface của hệ thống: Tự trắng khi Sáng, tự đen khi Tối -->
        <item name="android:statusBarColor">?attr/colorSurface</item>

        <!-- Bật tính năng tự động đảo màu chữ/icon theo nền -->
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="Theme.SampleCleanArchitecture" parent="Base.Theme.SampleCleanArchitecture" />

    <style name="full_screen_dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
    </style>
</resources>