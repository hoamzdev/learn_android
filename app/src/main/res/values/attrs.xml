<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="CircleProgressView">
        <attr name="backgroundColor" format="color" />
        <attr name="progressColor" format="color" />
        <attr name="progress" format="integer" />
    </declare-styleable>

    <declare-styleable name="CustomGroupView">
        <attr name="title" format="string" />
    </declare-styleable>

    <declare-styleable name="CustomLayout">
        <attr name="circleColor" format="color" />
        <attr name="circleRadius" format="dimension" />
        <attr name="strokeWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CircularTimerView">
        <attr name="timerBackgroundColor" format="color" />
        <attr name="timerProgressColor" format="color" />
        <attr name="timerTextColor" format="color" />
        <attr name="timerSubTextColor" format="color" />
        <attr name="timerStrokeWidth" format="dimension" />
        <attr name="timerTextSize" format="dimension" />
        <attr name="timerSubTextSize" format="dimension" />
        <attr name="timerMaxDurationMs" format="integer" />
    </declare-styleable>

</resources>