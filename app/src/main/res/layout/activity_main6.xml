<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.main.MainActivity6">

    <LinearLayout
        android:id="@+id/ln_name_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_37B43D"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.testBaseApp.ui.common.component.MovableText
            android:id="@+id/tv_name_file"
            style="@style/TextView.Subtext.14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size30"
            android:background="@color/color_37B43D"
            android:gravity="center_vertical|center_horizontal"
            android:paddingVertical="@dimen/size5"
            android:text="@string/next"
            android:textColor="@color/white" />

    </LinearLayout>


    <com.hwa.excelllll.ui.editor.ExcelViewerView
        android:id="@+id/viewExcel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/rcTabs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ln_name_file" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcTabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size35"
        android:background="@color/color_37B43D"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/ln_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:listitem="@layout/item_tab" />

    <LinearLayout
        android:id="@+id/ln_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/tvRotate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rotate"
            android:paddingVertical="@dimen/size6"
            android:gravity="center"
            android:textColor="@color/black"
            style="@style/TextView.CTA.16"/>

        <TextView
            android:id="@+id/tvEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit"
            android:paddingVertical="@dimen/size6"
            android:gravity="center"
            android:textColor="@color/black"
            style="@style/TextView.CTA.16"/>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>