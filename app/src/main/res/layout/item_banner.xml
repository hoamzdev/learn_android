<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/size10"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardItem"
        android:layout_width="@dimen/size144"
        android:layout_height="@dimen/size104"
        app:cardCornerRadius="@dimen/size12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="@android:color/transparent"
        android:background="@drawable/landscape_placeholder"
        app:cardElevation="@dimen/size0"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivItem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/mushroom"
            android:scaleType="fitXY"/>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvNameItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/cardItem"
        app:layout_constraintEnd_toEndOf="@id/cardItem"
        app:layout_constraintTop_toBottomOf="@id/cardItem"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/sizesp18"
        android:text="@string/app_name"/>



</androidx.constraintlayout.widget.ConstraintLayout>