<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ADFFFFFF"
    tools:context=".ui.main.MainActivity">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_12"
        android:layout_marginHorizontal="@dimen/size16"
        android:text="@string/login"
        app:layout_constraintBottom_toTopOf="@id/btnGet"
        android:textColor="@color/white"
        android:layout_marginBottom="@dimen/size12"
        android:textAllCaps="false"
        android:textSize="@dimen/sizesp16" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_12"
        android:layout_marginHorizontal="@dimen/size16"
        android:text="@string/get"
        android:textColor="@color/white"
        android:layout_marginBottom="@dimen/size100"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="@dimen/sizesp16"/>


</androidx.constraintlayout.widget.ConstraintLayout>