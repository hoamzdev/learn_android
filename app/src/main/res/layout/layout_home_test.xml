<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    android:layout_height="match_parent">


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_plant"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size176"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/bg_plant_12"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="@dimen/size16">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/image_test"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"/>

    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size82"
        android:layout_marginHorizontal="@dimen/size16"
        android:paddingHorizontal="@dimen/size12"
        android:background="@drawable/bg_gradient_content"
        android:paddingBottom="@dimen/size10"
        app:layout_constraintBottom_toBottomOf="@id/btn_plant">
    
        <TextView
            android:id="@+id/tv2"
            android:layout_width="@dimen/size187"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Scan or Use images of your plant to identify instantly."
            android:textSize="@dimen/sizesp12"
            style="@style/TextView.Subtext.12"
            android:textColor="@color/white"/>
        
        <TextView
            android:id="@+id/tv1"
            android:layout_width="@dimen/size187"
            android:layout_height="wrap_content"
            android:text="Identify Plant Instantly"
            android:textColor="@color/white"
            style="@style/TextView.Title.16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv2"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>