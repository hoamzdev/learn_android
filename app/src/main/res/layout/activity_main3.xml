<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.main.MainActivity3"
    android:background="@drawable/bg_login_screen"
    android:fillViewport="true"
    tools:ignore="ScrollViewCount">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_top"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.1"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/cardFormLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/gl_top"
            android:layout_marginHorizontal="@dimen/size16"
            android:background="@drawable/bg_card_login_form"
            android:orientation="vertical"
            android:padding="@dimen/size24">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivLogoApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_logo_app"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>


                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login"
                    android:textSize="@dimen/sizesp32"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:includeFontPadding="false"
                    android:layout_marginTop="@dimen/size24"
                    app:layout_constraintTop_toBottomOf="@id/ivLogoApp"
                    android:gravity="center"/>


                <TextView
                    android:id="@+id/tvSubTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/tvLogin"
                    android:text="Enter your email and password to log in"
                    android:textSize="@dimen/size12"
                    android:layout_marginTop="@dimen/size12"
                    android:gravity="center"
                    android:textColor="#9F000000"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutEdtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/tvSubTitle"
                    android:layout_marginTop="@dimen/size24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_edt_12"
                        android:hint="Enter your email"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/black"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/color_909A92"
                    app:layout_constraintTop_toBottomOf="@id/layoutEdtEmail"
                    android:layout_marginTop="@dimen/size6">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_edt_12"
                        android:hint="Enter your password"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:inputType="textPassword"
                        android:textColor="@color/black"/>

                </com.google.android.material.textfield.TextInputLayout>


                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cbRememberMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    android:minWidth="@dimen/size0"
                    android:minHeight="@dimen/size0"
                    android:checked="true"
                    app:layout_constraintTop_toBottomOf="@id/layoutPassword"
                    android:layout_marginTop="@dimen/size16"
                    android:buttonTint="@color/black"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remember me"
                    android:textSize="@dimen/sizesp12"
                    app:layout_constraintStart_toEndOf="@id/cbRememberMe"
                    app:layout_constraintTop_toTopOf="@id/cbRememberMe"
                    app:layout_constraintBottom_toBottomOf="@id/cbRememberMe"
                    android:layout_marginStart="@dimen/size5"
                    android:textColor="#9F000000"/>


                <TextView
                    android:id="@+id/btnForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password ?"
                    android:textColor="#1D61E7"
                    android:textStyle="bold"
                    android:textSize="@dimen/sizesp12"
                    app:layout_constraintTop_toTopOf="@id/cbRememberMe"
                    app:layout_constraintBottom_toBottomOf="@id/cbRememberMe"
                    app:layout_constraintEnd_toEndOf="parent"/>


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_12"
                    android:text="Login"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textSize="@dimen/sizesp14"
                    android:paddingVertical="@dimen/size16"
                    android:backgroundTint="#1D61E7"
                    app:layout_constraintTop_toBottomOf="@id/cbRememberMe"
                    android:layout_marginTop="@dimen/size24"/>

                <TextView
                    android:id="@+id/tvOrOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Or login with"
                    app:layout_constraintTop_toBottomOf="@id/btnLogin"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/size24"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_option_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size24"
                    app:layout_constraintTop_toBottomOf="@id/tvOrOption">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnGoogle"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/size48"
                        app:cardCornerRadius="@dimen/size12"
                        app:cardBackgroundColor="@color/white"
                        app:strokeWidth="@dimen/size0"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnFb"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/size20"
                            android:layout_height="@dimen/size20"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_google"/>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnFb"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/size48"
                        app:cardCornerRadius="@dimen/size12"
                        app:cardBackgroundColor="@color/white"
                        app:strokeWidth="@dimen/size0"

                        android:layout_marginLeft="@dimen/size16"

                        app:layout_constraintStart_toEndOf="@id/btnGoogle"
                        app:layout_constraintEnd_toStartOf="@id/btnApple"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/size20"
                            android:layout_height="@dimen/size20"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_facebook"/>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnApple"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/size48"
                        app:cardCornerRadius="@dimen/size12"
                        app:strokeWidth="@dimen/size0"
                        app:cardBackgroundColor="@color/white"

                        android:layout_marginLeft="@dimen/size16"

                        app:layout_constraintStart_toEndOf="@id/btnFb"
                        app:layout_constraintEnd_toStartOf="@id/btnPhone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/size20"
                            android:layout_height="@dimen/size20"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_apple"/>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPhone"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/size48"
                        app:cardCornerRadius="@dimen/size12"
                        app:cardBackgroundColor="@color/white"
                        app:strokeWidth="@dimen/size0"
                        android:layout_marginLeft="@dimen/size16"
                        app:layout_constraintStart_toEndOf="@id/btnApple"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/size20"
                            android:layout_height="@dimen/size20"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_device_mobile" />

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/lnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/cl_option_login"
                    android:layout_marginTop="@dimen/size24"
                    android:weightSum="3"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:layout_height="wrap_content"
                        android:text="Don’t have an account?"
                        android:gravity="end"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_option_login"
                        android:textColor="#9F000000"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sign Up"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/size6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_option_login"
                        android:textColor="#4D81E7"/>

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.core.widget.NestedScrollView>